---
import { Image } from 'astro:assets';
import Tag from '../common/Tag.astro';

interface Props {
  title: string;
  tagline: string;
  category: 'Residencial' | 'Paisajismo' | 'Interiorismo' | 'Dirección de Obra';
  location: string;
  year: number;
  surfaceArea: string;
  coverImage: any;
  coverAlt: string;
  aspect?: 'landscape' | 'portrait' | 'square';
  class?: string;
}

const {
  title,
  tagline,
  category,
  location,
  year,
  surfaceArea,
  coverImage,
  coverAlt,
  aspect = 'landscape',
  class: className = '',
} = Astro.props;

const aspectClasses = {
  landscape: 'aspect-[16/10] sm:aspect-[16/11]',
  portrait: 'aspect-[3/4] sm:aspect-[4/5]',
  square: 'aspect-square',
};
---

<article class={`group relative overflow-hidden flex flex-col reveal-on-scroll ${className}`}>
  <!-- Image Container with Smooth Hover Scale -->
  <div class={`w-full overflow-hidden relative bg-surface-dark/5 ${aspectClasses[aspect]}`}>
    <Image
      src={coverImage}
      alt={coverAlt}
      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
      widths={[480, 800, 1200]}
      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 800px"
      format="webp"
    />
    
    <!-- Subtle gradient overlay on hover -->
    <div class="absolute inset-0 bg-gradient-to-t from-surface-dark/70 via-surface-dark/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex flex-col justify-end p-6 sm:p-8 text-surface-neutral">
      <p class="font-sans text-xs tracking-widest uppercase text-accent-secondary mb-1">
        {location} · {year}
      </p>
      <p class="font-sans text-xs text-surface-neutral/80 font-light">
        Superficie: {surfaceArea}
      </p>
    </div>

    <!-- Category Floating Badge -->
    <div class="absolute top-4 left-4 z-10">
      <Tag text={category} variant="light" class="shadow-sm backdrop-blur-md bg-surface-neutral/90" />
    </div>
  </div>

  <!-- Editorial Card Footer / Metadata -->
  <div class="pt-5 flex items-start justify-between gap-4">
    <div>
      <h3 class="text-xl sm:text-2xl font-serif text-surface-dark group-hover:text-accent-primary transition-colors duration-300">
        {title}
      </h3>
      <p class="font-sans text-xs sm:text-sm text-slate-muted mt-1 font-light leading-relaxed max-w-md">
        {tagline}
      </p>
    </div>
    <div class="text-right shrink-0 pt-1">
      <span class="font-sans text-xs text-slate-muted tracking-widest">{year}</span>
    </div>
  </div>
</article>
