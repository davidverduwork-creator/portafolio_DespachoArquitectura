---
interface Props {
  text?: string;
  href?: string;
  class?: string;
}

const { text = 'DESCUBRIR', href = '/home', class: className = '' } = Astro.props;
---

<a
  href={href}
  class={`group inline-flex flex-col items-center gap-3 text-surface-neutral/80 hover:text-surface-neutral transition-colors duration-300 ${className}`}
  aria-label="Desplazar hacia la experiencia principal"
>
  <span class="font-sans text-[11px] uppercase tracking-ultra font-light select-none group-hover:tracking-[0.45em] transition-all duration-500">
    {text}
  </span>
  <div class="w-[1px] h-10 bg-surface-neutral/30 relative overflow-hidden">
    <div class="w-full h-1/2 bg-accent-secondary animate-pulse-line"></div>
  </div>
</a>

<style>
  @keyframes pulseLine {
    0% {
      transform: translateY(-100%);
    }
    50% {
      transform: translateY(100%);
    }
    100% {
      transform: translateY(200%);
    }
  }

  .animate-pulse-line {
    animation: pulseLine 2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
</style>
