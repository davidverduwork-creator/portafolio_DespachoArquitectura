---
const currentYear = new Date().getFullYear();

const socialLinks = [
  { name: 'Instagram', href: 'https://instagram.com', handle: '@lindesur.arch' },
  { name: 'ArchDaily', href: 'https://archdaily.com', handle: 'LINDE Sur' },
  { name: 'LinkedIn', href: 'https://linkedin.com', handle: 'LINDE Sur Architect Studio' },
];

const studioLocations = [
  { city: 'Andalucía', address: 'Plaza del Deán Mazas, 4 · 23001 Jaén' },
  { city: 'Madrid', address: 'Calle Claudio Coello, 28 · 28001 Madrid' },
];
---

<footer id="contacto" class="bg-surface-dark text-surface-neutral pt-24 pb-12 px-6 sm:px-10 lg:px-16 border-t border-surface-neutral/10">
  <div class="max-w-7xl mx-auto">
    <!-- Top Grid -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 lg:gap-16 pb-20 border-b border-surface-neutral/15">
      <!-- Col 1: Brand & Manifesto Pitch (5 cols) -->
      <div class="md:col-span-5 flex flex-col justify-between">
        <div>
          <img
            src="/logo/whiteCombinationMark.svg"
            alt="LINDE Sur Architect Studio"
            class="h-10 w-auto mb-8 opacity-90"
            width="200"
            height="72"
          />
          <p class="font-sans text-surface-neutral/70 text-sm sm:text-base leading-relaxed max-w-sm font-light">
            Arquitectura residencial contemporánea, paisajismo y dirección técnica. Proyectos concebidos desde la materia, la proporción y el diálogo silencioso con el entorno.
          </p>
        </div>

        <div class="mt-8">
          <p class="font-sans text-xs uppercase tracking-ultra text-accent-secondary mb-2">Consulta de proyectos</p>
          <a
            href="mailto:estudio@lindesur.com"
            class="text-xl sm:text-2xl font-serif hover:text-accent-secondary transition-colors duration-300 block underline underline-offset-4 decoration-accent-secondary/50"
          >
            estudio@lindesur.com
          </a>
          <p class="font-sans text-xs text-surface-neutral/50 mt-1">+34 953 22 10 40</p>
        </div>
      </div>

      <!-- Col 2: Locations (4 cols) -->
      <div class="md:col-span-4 flex flex-col gap-8">
        <h3 class="font-sans text-xs uppercase tracking-ultra text-accent-secondary">Sedes del Estudio</h3>
        <div class="flex flex-col gap-6">
          {
            studioLocations.map((loc) => (
              <div>
                <p class="text-base font-serif text-surface-neutral mb-1">{loc.city}</p>
                <p class="font-sans text-xs text-surface-neutral/60 font-light leading-relaxed">{loc.address}</p>
              </div>
            ))
          }
        </div>

        <div class="pt-4">
          <p class="font-sans text-xs uppercase tracking-ultra text-accent-secondary mb-3">Horario de Atención</p>
          <p class="font-sans text-xs text-surface-neutral/60 font-light">Lunes a Viernes: 09:00 — 19:30 h</p>
        </div>
      </div>

      <!-- Col 3: Publications & Socials (3 cols) -->
      <div class="md:col-span-3 flex flex-col gap-8">
        <h3 class="font-sans text-xs uppercase tracking-ultra text-accent-secondary">Publicaciones & Redes</h3>
        <ul class="flex flex-col gap-4 font-sans text-xs">
          {
            socialLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group flex items-center justify-between text-surface-neutral/70 hover:text-surface-neutral transition-colors py-1 border-b border-surface-neutral/10"
                >
                  <span>{item.name}</span>
                  <span class="text-accent-secondary group-hover:translate-x-1 transition-transform duration-300 text-[10px]">
                    ↗
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Bottom Legal Bar -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-sans text-[11px] text-surface-neutral/40 font-light">
      <p>© {currentYear} LINDE Sur — Architect Studio. Todos los derechos reservados.</p>
      <div class="flex items-center gap-6">
        <a href="#aviso-legal" class="hover:text-surface-neutral transition-colors">Aviso Legal</a>
        <span>·</span>
        <a href="#privacidad" class="hover:text-surface-neutral transition-colors">Política de Privacidad</a>
        <span>·</span>
        <a href="#cookies" class="hover:text-surface-neutral transition-colors">Cookies</a>
      </div>
    </div>
  </div>
</footer>
