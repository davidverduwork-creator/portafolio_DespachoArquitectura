---
interface Props {
  variant?: 'light' | 'transparent';
  class?: string;
}

const { variant = 'light', class: className = '' } = Astro.props;

const navLinks = [
  { name: 'Estudio', href: '#estudio' },
  { name: 'Proyectos', href: '#proyectos' },
  { name: 'Servicios', href: '#servicios' },
  { name: 'Proceso', href: '#proceso' },
  { name: 'Contacto', href: '#contacto' },
];
---

<header
  id="main-navbar"
  class={`fixed top-0 left-0 w-full z-50 transition-all duration-500 py-5 px-6 sm:px-10 lg:px-16 ${
    variant === 'transparent' ? 'bg-transparent' : 'bg-surface-neutral/85 backdrop-blur-md border-b border-accent-secondary/20 shadow-sm'
  } ${className}`}
>
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/home" class="flex items-center gap-3 group" aria-label="LINDE Sur - Inicio">
      <img
        src="/logo/blackLogo.svg"
        alt="LINDE Sur Architect Studio"
        class="h-8 sm:h-9 w-auto object-contain transition-opacity duration-300 group-hover:opacity-80"
        width="160"
        height="58"
      />
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden md:flex items-center gap-8 lg:gap-10" aria-label="Navegación principal">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="font-sans text-xs uppercase tracking-widest text-surface-dark/80 hover:text-accent-primary transition-colors duration-300 relative py-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[1px] after:bg-accent-primary hover:after:w-full after:transition-all after:duration-300"
          >
            {link.name}
          </a>
        ))
      }
    </nav>

    <!-- Right Action Button & Mobile Burger -->
    <div class="flex items-center gap-4">
      <a
        href="#contacto"
        class="hidden sm:inline-flex items-center text-xs font-sans uppercase tracking-widest px-5 py-2.5 border border-accent-primary text-accent-primary hover:bg-accent-primary hover:text-surface-neutral transition-all duration-300"
      >
        Iniciar Diálogo
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="md:hidden p-2 text-surface-dark hover:text-accent-primary focus:outline-none"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="w-6 h-6 stroke-current stroke-[1.5] fill-none" viewBox="0 0 24 24">
          <line x1="3" y1="7" x2="21" y2="7" id="line1" class="transition-transform duration-300"></line>
          <line x1="3" y1="17" x2="21" y2="17" id="line2" class="transition-transform duration-300"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu (Native HTML & CSS) -->
  <div
    id="mobile-menu"
    class="fixed inset-0 top-[73px] bg-surface-neutral/95 backdrop-blur-xl z-40 flex flex-col justify-between p-8 transform translate-x-full transition-transform duration-500 ease-in-out md:hidden border-t border-accent-secondary/20"
  >
    <nav class="flex flex-col gap-6 pt-6">
      {
        navLinks.map((link, idx) => (
          <a
            href={link.href}
            class="mobile-nav-link text-2xl font-serif text-surface-dark hover:text-accent-primary transition-colors duration-200 border-b border-accent-secondary/20 pb-4"
          >
            <span class="text-xs font-sans text-accent-secondary tracking-widest mr-3">0{idx + 1}</span>
            {link.name}
          </a>
        ))
      }
    </nav>

    <div class="border-t border-accent-secondary/30 pt-6">
      <p class="font-sans text-xs text-slate-muted uppercase tracking-widest mb-2">Contacto directo</p>
      <a href="mailto:info@lindesur.com" class="font-sans text-sm text-surface-dark hover:text-accent-primary font-medium">
        info@lindesur.com
      </a>
      <p class="font-sans text-xs text-slate-muted mt-4">Jaén · Madrid · Costa de la Luz</p>
    </div>
  </div>
</header>

<script>
  // Native Mobile Menu Toggle & Scroll spy / Shrink
  function setupNav() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const navLinks = document.querySelectorAll('.mobile-nav-link');
    const navbar = document.getElementById('main-navbar');

    if (toggleBtn && mobileMenu) {
      let isOpen = false;

      const toggleMenu = () => {
        isOpen = !isOpen;
        toggleBtn.setAttribute('aria-expanded', String(isOpen));
        if (isOpen) {
          mobileMenu.classList.remove('translate-x-full');
          mobileMenu.classList.add('translate-x-0');
          document.body.style.overflow = 'hidden';
        } else {
          mobileMenu.classList.add('translate-x-full');
          mobileMenu.classList.remove('translate-x-0');
          document.body.style.overflow = '';
        }
      };

      toggleBtn.onclick = toggleMenu;

      navLinks.forEach((link) => {
        link.addEventListener('click', () => {
          if (isOpen) toggleMenu();
        });
      });
    }

    // Scroll header styling
    window.addEventListener('scroll', () => {
      if (!navbar) return;
      if (window.scrollY > 50) {
        navbar.classList.add('py-3.5', 'shadow-sm');
        navbar.classList.remove('py-5');
      } else {
        navbar.classList.remove('py-3.5', 'shadow-sm');
        navbar.classList.add('py-5');
      }
    });
  }

  setupNav();
  document.addEventListener('astro:page-load', setupNav);
</script>
